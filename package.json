{
  "name": "the-other-side",
  "version": "1.0.0",
  "description": "Two worlds. One mind. Dual-world grid-based logic puzzle.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"const fs=require('fs'); if (!fs.existsSync('.tmp')) fs.mkdirSync('.tmp');\" && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:levels": "vite-node scripts/validateLevels.ts",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
